# Server-only Supabase connection used by app/api/stories/route.ts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional legacy fallback if your project has not migrated to Supabase secret keys.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optional: the final public website URL used for canonical and social metadata.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
